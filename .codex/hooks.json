{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.agents/hooks/ruff.sh",
            "timeout": 30,
            "statusMessage": "ruff format + check"
          }
        ]
      }
    ]
  }
}
