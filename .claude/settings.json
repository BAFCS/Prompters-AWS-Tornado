{
  "enabledPlugins": {
    "expo@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/hooks/ruff.sh",
            "timeout": 30,
            "statusMessage": "ruff format + check"
          }
        ]
      }
    ]
  }
}
